@func printLn(msg, a, b, c, d) {
    __printLn(msg, a, b, c, d);
}

@func log(msg) {
    print(msg);
}

@func assert(condition) {
    # In the future we would throw an error here, 
    # but for now we can just print if it fails
    # (control flow is not fully implemented yet)
    print("Assertion evaluated:", condition);
}
