@const $std = @import("std");

# Allocate 5 slots in our VM's linear memory
$arr = std.mem.alloc(5);

# Treat the pointer like an array!
arr[0] = 42;
arr[1] = 1337;
arr[2] = 2026;

std.debug.printLn("arr[0] = {i}", arr[0]);
std.debug.printLn("arr[1] = {i}", arr[1]);
std.debug.printLn("arr[2] = {i}", arr[2]);

std.debug.assert(arr[0] == 42);
std.debug.assert(arr[1] == 1337);
std.debug.assert(arr[2] == 2026);
